*.py[cod]
.venv/
venv/
.env
*.egg-info/

# Fabric snapshots — run data, not repository data
snapshots/
*.snapshot.json

# Terraform
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
tfplan
crash.log
# Rendered from 06-pipeline/data/fabric.yaml by render.py. Generated,
