tfplan.txt
idempotency.txt

# Backend configuration (module 5, PART C). Addresses would be harmless, but
# this is the file people paste a personal access token into — so it never
# gets the chance to be committed. The example stays.
backend.hcl
!backend.hcl.example

# NEVER commit: the Vault token
.vault-token
.pytest_cache/
