# Copy to terraform.tfvars (which is in .gitignore).
#
# Credentials do NOT go here. They come out of Vault as environment variables:
#
#   export TF_VAR_vmanage_url=$(vault kv get -field=url secret/sdwan/manager)
#   export TF_VAR_vmanage_username=$(vault kv get -field=username secret/sdwan/manager)
#   export TF_VAR_vmanage_password=$(vault kv get -field=password secret/sdwan/manager)
#
# Or use the repo shortcut:  source ../scripts/vault-env.sh

student     = "07"
banner_motd = "Managed by Terraform - AutoNetOps Bootcamp"
