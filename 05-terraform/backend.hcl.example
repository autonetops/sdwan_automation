# Copy to backend.hcl (gitignored) and fill in the two placeholders.
#
#     terraform init -migrate-state -backend-config=backend.hcl
#
# NOTE WHAT IS NOT IN THIS FILE: username and password. The http backend
# also reads TF_HTTP_USERNAME and TF_HTTP_PASSWORD from the environment, so
# the token stays out of a file that is one `git add -f` away from being
# public. Addresses go in the file, secrets go in the environment — the same
# split you applied to the Manager credentials in PART B.
#
#     export TF_HTTP_USERNAME="<your gitlab username>"
#     export TF_HTTP_PASSWORD="<personal access token, scope: api>"
#
# PROJECT_ID: GitLab project → Settings → General, under the project name.
# STATE_NAME: anything, but make it yours — ws<NN>-sdwan. One project can
#             hold many named states; two students sharing a name share a
#             state, which is exactly the collision the ws<NN>- prefix rule
#             exists to prevent.

address        = "https://gitlab.autonetops.com/api/v4/projects/PROJECT_ID/terraform/state/ws00-sdwan"
lock_address   = "https://gitlab.autonetops.com/api/v4/projects/PROJECT_ID/terraform/state/ws00-sdwan/lock"
unlock_address = "https://gitlab.autonetops.com/api/v4/projects/PROJECT_ID/terraform/state/ws00-sdwan/lock"

# GitLab's state API expects these verbs. They are not the backend's
# defaults, and getting them wrong produces a 404 at lock time that reads
# like the state does not exist.
lock_method   = "POST"
unlock_method = "DELETE"

# GitLab returns 409 while another apply holds the lock. Wait rather than
# fail: in a pipeline the other apply is usually seconds from finishing.
retry_wait_min = 5
