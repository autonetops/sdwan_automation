# Copy to terraform.tfvars (which is in .gitignore).
#
# Credentials do NOT go here, and in the finished version they do not go in
# the environment either: `credentials_from_vault` defaults to true, so
# Terraform reads workshop/sdwan itself. All you export is the token.
#
#   export VAULT_ADDR=https://vault.autonetops.com
#   export VAULT_TOKEN=hvs.xxxxxxxx
#
# The TF_VAR_vmanage_* path still exists for an environment that already
# fetched the secret another way (the GitHub workflow does):
#
#   credentials_from_vault = false

# Your number normally comes from WS_STUDENT (vault-env.sh exports it as
# TF_VAR_student). Uncomment here ONLY to override — a value in this file
# beats the environment, which is how a whole class ends up as ws07-.
# student   = "07"

banner_motd = "Managed by Terraform - AutoNetOps Bootcamp"

# Defaults are right for the bootcamp lab; override only if the secret moved.
# vault_address     = "https://vault.autonetops.com"
# vault_mount       = "workshop"
# vault_secret_path = "sdwan"

# State settings are NOT here: a backend block cannot read variables. They
# live in backend.hcl (laptop) or TF_HTTP_* (pipeline). See backend.tf.

# ── From module 6 on, these are GENERATED ───────────────────────────
# banner_motd, banner_login, config_group_name, config_group_description and
# student are rendered into generated.auto.tfvars.json from
# 06-pipeline/data/fabric.yaml. A *.auto.tfvars.json file beats this one, so
# a value set in both places is a value that silently does not apply.
