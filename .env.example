# Copy to .env and fill in. .env is in .gitignore — keep it that way.

# ── Vault ───────────────────────────────────────────────────────────
# Authentication is userpass: a personal, read-only login handed out at the
# start of the bootcamp. There is no fallback — see 01-vault-credentials for
# why that is deliberate.
VAULT_ADDR=https://vault.autonetops.com
VAULT_USERNAME=
VAULT_PASSWORD=

# Where the Manager secret lives (toolkit defaults; only change if the
# instructor says so). Keys: url, username, password.
VAULT_SDWAN_MOUNT=workshop
VAULT_SDWAN_PATH=sdwan

# Your bootcamp number. Everything you create in the shared lab is prefixed
# with it, so you don't collide with the rest of the class.
WS_STUDENT=07
