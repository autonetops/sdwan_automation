# Copie para .env e preencha. O .env está no .gitignore — mantenha assim.

# ── Caminho recomendado: Vault ──────────────────────────────────────
# O token de leitura é entregue no início do bootcamp.
#VAULT_ADDR=https://vault.autonetops.com
#VAULT_TOKEN=

# Onde mora o segredo (padrões do toolkit; só mude se o instrutor pedir)
#VAULT_SDWAN_MOUNT=secret
#VAULT_SDWAN_PATH=sdwan/manager

# ── Fallback: só para desenvolvimento offline e CI ──────────────────
# Se VAULT_TOKEN estiver vazio, o toolkit usa estas três.
# VMANAGE_URL=https://manager.lab.autonetops.com
# VMANAGE_USERNAME=
# VMANAGE_PASSWORD=
