# Copy to .env and fill in. .env is in .gitignore — keep it that way.

# ── Recommended path: Vault ─────────────────────────────────────────
# The read-only token is handed out at the start of the bootcamp.
VAULT_ADDR=https://vault.autonetops.com
VAULT_TOKEN=

# Where the secret lives (toolkit defaults; only change if the instructor says so)
VAULT_SDWAN_MOUNT=secret
VAULT_SDWAN_PATH=sdwan/manager

# Your bootcamp number. Everything you create in the shared lab is prefixed
# with it, so you don't collide with the rest of the class.
WS_STUDENT=07

# ── Fallback: offline development and CI only ───────────────────────
# If VAULT_TOKEN is empty, the toolkit uses these three instead.
# VMANAGE_URL=https://manager.lab.autonetops.com
# VMANAGE_USERNAME=
# VMANAGE_PASSWORD=
